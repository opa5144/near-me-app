# Reference only: copy the values you choose into your existing backend/.env.
# Keep external delivery disabled until credentials, sender identities, and user opt-ins are ready.
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_EXTERNAL_DELIVERY_ENABLED=false
NOTIFICATIONS_POLL_MS=5000
NOTIFICATIONS_BATCH_SIZE=20
NOTIFICATIONS_LEASE_MS=120000
NOTIFICATIONS_REMINDER_GRACE_MS=120000
NOTIFICATIONS_MAX_ATTEMPTS=5

# Resend: verified sending domain/address, plus a server-side API key.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Twilio: use either a Messaging Service SID or a From number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Expo: project UUID and access token; enable push access-token security in Expo.
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=
